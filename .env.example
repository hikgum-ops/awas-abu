# Optional for the website. Use a dedicated Fonnte device and number for WhatsApp.
FONNTE_TOKEN=replace-me

# Site-specific ChatGPT user IDs or emails allowed to publish through /operator.
AWASABU_OPERATOR_USER_IDS=replace-with-account-user-id
AWASABU_OPERATOR_EMAILS=operator@example.com

# Generate separate, high-entropy secrets for optional API and webhook access.
AWASABU_WEBHOOK_SECRET=replace-me
AWASABU_OPERATOR_KEY=replace-me
